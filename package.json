{
  "name": "vyradee-social-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Creator content workflow API for VyraDee Social",
  "main": "dist/server.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/setup.mjs",
    "db:studio": "node scripts/prisma-env.mjs studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@google/genai": "^2.27.0",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "prisma": "^6.12.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
